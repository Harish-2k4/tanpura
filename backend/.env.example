# Copy to backend/.env and fill in. Blank values = mock mode / development defaults.

# Teacher sign-in (required in production)
APP_EMAIL=teacher@tanpura.app
APP_PASSWORD=
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Demo mode: shows the demo login on the sign-in page and allows resetting demo data
DEMO_MODE=true
# Sandbox personal (buyer) account email; used as one family's email so you can pay a demo invoice
DEMO_BUYER_EMAIL=

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# Enable "Transaction search" on the app for the Payments tab.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Webhook id from the same app (events: Invoicing invoice paid / cancelled), URL https://<your-host>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# AG Studio licence key for the dashboard (runs with a watermark without one)
AG_STUDIO_LICENSE=

# Gemini (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=
